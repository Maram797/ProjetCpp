           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QPushButton" name="btnSupprimer">
           <property name="cursor">
            <cursorShape>PointingHandCursor</cursorShape>
           </property>
           <property name="styleSheet">
            <string notr="true">
                background-color: #FFF0F2;
                color: #C0392B;
                border: 1.5px solid #F6A5B5;
                border-radius: 8px;
                font-weight: bold;
                font-size: 11px;
                padding: 7px 12px;
            </string>
           </property>
           <property name="text">
            <string>🗑 Supprimer</string>
