}


#frame {
    background-color: #FFF9F4;
    border-right: 1px solid #F9DEE4;
}                                                                                                                                           QPushButton {
    background-color: transparent;
    color: #6B3F2E;
    border: none;
    text-align: left;
    padding-left: 15px;
    font-size: 14px;
    border-radius: 8px;
}

QPushButton:hover {
    background-color: #F9DEE4; /* Rose clair */
}


QPushButton:checked, QPushButton:pressed {
    background-color: #E77C8D; /* Rose principale */
    color: #FFF9F4;
}      </string>
