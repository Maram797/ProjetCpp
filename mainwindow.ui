<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1300</width>
    <height>750</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Pawché - Smart Pet Center</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow, #centralwidget, #centre, #pagescentre, #pageliste, #pageformulaire, #pagemodule,
#colonnedroite, #lignePoste, #ligneDb { background-color: #FBF4EE; }
QLabel { color: #713923; background-color: transparent; }

/* Inputs */
QLineEdit, QComboBox, QSpinBox {
  background-color: white; border: 1px solid #E8D8D0; border-radius: 8px;
  padding: 6px 8px; font-size: 10pt; color: black;
}
QComboBox QAbstractItemView {
  background-color: white; color: black;
  selection-background-color: #F8E5DF; selection-color: black;
}
#combocabinet { background-color: #F8E5DF; color: #713923; font-weight: bold; border: none; }

/* Left menu */
#sidebar { background-color: #FBF4EE; border: none; }
#lblmarque { font-size: 16pt; font-weight: bold; }
#lblposte, #lblpostenum { font-size: 7pt; font-weight: bold; }
#lblnomvet { font-size: 10pt; font-weight: bold; margin-top: 4px; }
#lbldb, #lbldbms { font-size: 8pt; }
#btnanimaux, #btnproprietaires, #btnconsultations, #btnproduits, #btnfacturation {
  text-align: left; padding: 8px; border: 1px solid #713923; border-radius: 6px;
  font-size: 9pt; color: #713923; background-color: transparent;
}
#btnanimaux:hover, #btnproprietaires:hover, #btnconsultations:hover, #btnproduits:hover, #btnfacturation:hover { background-color: #F8E5DF; }
#btnanimaux:checked, #btnproprietaires:checked, #btnconsultations:checked, #btnproduits:checked, #btnfacturation:checked {
  background-color: #713923; color: white; font-weight: bold;
}
#btnsync {
  background-color: transparent; color: #713923; border: 1px solid #713923; border-radius: 6px;
  padding: 8px; font-size: 9pt;
}
#btnsync:hover { background-color: #F8E5DF; }

/* Top bar */
#editrecherche { padding: 8px; }
#lblavatar { background-color: #F8E5DF; border-radius: 18px; font-size: 9pt; font-weight: bold; }
#btnnouvelanimal, #btnajouter {
  background-color: #713923; color: white; border: 2px solid #713923; border-radius: 6px;
  padding: 8px 16px; font-size: 10pt; font-weight: bold;
}
#btnnouvelanimal:hover, #btnajouter:hover { background-color: #8A4A2F; }
#btnannuler, #btnmodifier, #btnsupprimer {
  background-color: transparent; color: #713923; border: 2px solid #713923; border-radius: 6px;
  padding: 8px 16px; font-size: 10pt; font-weight: bold;
}
#btnannuler:hover, #btnmodifier:hover { background-color: #F8E5DF; }
#btnsupprimer:hover { background-color: #C2455F; border-color: #C2455F; color: white; }
#btnmodifier:disabled, #btnsupprimer:disabled { color: #CDB5A8; border-color: #E8D8D0; }

/* Page header + filter tabs */
#lbltitrepage, #lbltitremodule { font-size: 22pt; font-weight: bold; color: black; }
#lblsoustitrepage, #lblmodule { font-size: 11pt; color: black; }
#btntous, #btnchiens, #btnchats {
  background-color: transparent; color: #713923; border: none; border-radius: 6px;
  padding: 8px 14px; font-size: 10pt; font-weight: bold;
}
#btntous:checked, #btnchiens:checked, #btnchats:checked { background-color: #F8E5DF; }

/* Table */
#tableanimaux {
  background-color: white; border: 1px solid #E8D8D0; border-radius: 12px;
  font-size: 10pt; color: black; outline: 0;
  gridline-color: transparent; alternate-background-color: #FBF4EE;
}
#tableanimaux::item { padding: 8px; border: none; }
#tableanimaux::item:selected { background-color: #F8E5DF; color: black; }
QHeaderView { background-color: #F8E5DF; border: none; }
QTableCornerButton::section { background-color: #F8E5DF; border: none; }
QHeaderView::section { background-color: #F8E5DF; color: #713923; font-size: 8pt; font-weight: bold;
  border: none; border-right: 1px solid #E8D8D0; border-bottom: 1px solid #E8D8D0; padding: 8px; }

/* Statistics bars */
#barresains, #barreensoin, #barreurgent { background-color: #F3E9E2; border: none; border-radius: 6px; }
#barresains::chunk { background-color: #713923; border-radius: 6px; }
#barreensoin::chunk { background-color: #D9A384; border-radius: 6px; }
#barreurgent::chunk { background-color: #EE91A5; border-radius: 6px; }
#lblbsains, #lblbensoin, #lblburgent { font-size: 8pt; }

/* Cards */
#cadrestatistiques, #cadredetail { background-color: white; border: 1px solid #E8D8D0; border-radius: 16px; }
#cadrestatistiques QLabel, #cadredetail QLabel { border: none; background-color: transparent; }
#lbltitrestats, #lbltitredetail { font-size: 12pt; font-weight: bold; }
#lblsante { color: #287554; font-size: 8pt; }
#cadredetail QLabel { color: black; }
#cadredetail #lblphoto { background-color: #F8E5DF; border-radius: 20px; font-size: 48pt; }
#cadredetail #lblnom { font-size: 16pt; font-weight: bold; }
#cadredetail #valage, #cadredetail #valpuce, #cadredetail #valvaccinal,
#cadredetail #valproprietaire, #cadredetail #valtelephone, #cadredetail #valstatut { font-weight: bold; }
#cadredetail #lignedetail { background-color: #E8D8D0; border: none; }
#btnfermer { background-color: transparent; color: #713923; border: none; border-radius: 14px; font-size: 11pt; }
#btnfermer:hover { background-color: #F8E5DF; }
#btnconsulter {
  background-color: #F8E5DF; color: #713923; border: 2px solid #713923; border-radius: 6px;
  padding: 8px 16px; font-size: 10pt; font-weight: bold;
}
#btnconsulter:hover { background-color: #713923; color: white; }

/* New / edit animal form */
#cadreformulaire { background-color: white; border: 1px solid #E8D8D0; border-radius: 16px; }
#cadreformulaire QLabel { border: none; background-color: transparent; }
#lbltitreformulaire { font-size: 16pt; font-weight: bold; }
#lblerreur { color: #C2455F; font-size: 9pt; }
</string>
