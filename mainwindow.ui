   <string notr="true">
    QMainWindow {
        background-color: #FAF5F0;
    }
    QWidget#centralwidget {
        background-color: #FAF5F0;
    }
    QFrame#sidebarFrame {
        background-color: #FFFDF9;
        border: 1px solid #EFE4DC;
        border-radius: 16px;
    }
    QPushButton.navButton {
        background-color: transparent;
        border: 1px solid #D9C3B5;
        border-radius: 8px;
        padding: 9px 12px;
        text-align: center;
        color: #5C3826;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 11px;
        font-weight: 600;
    }
    QPushButton.navButton:hover {
        background-color: #F8EEE6;
        border-color: #633927;
    }
    QPushButton.navButton[active=&quot;true&quot;], QPushButton.navButton[active=&quot;true&quot;]:hover {
        background-color: #633927;
        border: 1px solid #633927;
        border-radius: 8px;
        padding: 9px 12px;
        text-align: center;
        color: #FFFFFF;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 11px;
        font-weight: bold;
    }
    QFrame.cardFrame {
        background-color: #FFFFFF;
        border: 1px solid #EFE6DF;
        border-radius: 14px;
    }
    QLineEdit, QDateEdit, QDoubleSpinBox, QSpinBox, QComboBox {
        background-color: #FFFFFF;
        border: 1.5px solid #D9C3B5;
        border-radius: 8px;
        padding: 6px 10px;
        color: #3D2619;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 11px;
    }
    QLineEdit:focus, QDateEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus {
        border: 1.5px solid #633927;
        background-color: #FFFDF9;
    }
    QTableWidget {
        background-color: #FFFFFF;
        border: 1px solid #EFE6DF;
        border-radius: 12px;
        gridline-color: #F5EEE9;
        color: #3D2619;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 11px;
        selection-background-color: #F8E2E6;
        selection-color: #3D2619;
    }
    QHeaderView::section {
        background-color: #FFF7F2;
        color: #633927;
        font-weight: bold;
        border: none;
        border-bottom: 2px solid #EEDCD0;
        padding: 8px 6px;
        font-size: 11px;
    }
    QPushButton.actionBtn {
        background-color: #633927;
        color: #FFFFFF;
        border-radius: 8px;
        font-weight: bold;
        font-size: 11px;
        padding: 8px 14px;
        border: none;
    }
    QPushButton.actionBtn:hover {
        background-color: #4D2B1D;
    }
    QPushButton.secondaryBtn {
        background-color: #FFFFFF;
        color: #633927;
        border: 1.5px solid #633927;
        border-radius: 8px;
        font-weight: bold;
        font-size: 11px;
