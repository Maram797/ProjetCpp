        font-weight: 600;
    }
    QPushButton.navButton:hover {
        background-color: #F8EEE6;
        border-color: #633927;
    }
    QPushButton.navButton[active="true"], QPushButton.navButton[active="true"]:hover {
        background-color: #633927;
        border: 1px solid #633927;
        border-radius: 8px;
        padding: 9px 12px;
